# ============================================================
# SNS自動投稿 + 月10万円AIエージェント 環境変数テンプレート
# このファイルを .env にコピーして各値を設定してください
# GitHub Actions を使う場合は Settings > Secrets and variables > Actions に登録
# ============================================================

# ── Gemini API ────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Supabase ─────────────────────────────────────────────────
# https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── Bluesky ───────────────────────────────────────────────────
# BSKY_APP_PASSWORD は Settings > Privacy and security > App Passwords で生成
BSKY_HANDLE=
BSKY_APP_PASSWORD=
BSKY_PASSWORD=

# ── X (Twitter) ───────────────────────────────────────────────
# https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# twikit 用 Cookie（JSON文字列。x_automation/x_cookies.json の内容）
X_COOKIES=
# twikit ログイン用
X_USERNAME=
X_EMAIL=

# ── はてなブログ (AtomPub API) ────────────────────────────────
# APIキー取得: https://blog.hatena.ne.jp/{HATENA_ID}/{HATENA_BLOG_ID}/config/api
HATENA_ID=
HATENA_BLOG_ID=
HATENA_BLOG_DOMAIN=
HATENA_API_KEY=

# ── note.com ─────────────────────────────────────────────────
NOTE_EMAIL=
NOTE_PASSWORD=

# ── A8.net ───────────────────────────────────────────────────
# pub.a8.net のメディアID（ログインID）とパスワード
A8_MEDIA_ID=
A8_PASSWORD=

# ── Bitly ────────────────────────────────────────────────────
# https://app.bitly.com/settings/api/
BITLY_ACCESS_TOKEN=

# ── Amazon PA-API ─────────────────────────────────────────────
# https://affiliate.amazon.co.jp/assoc_credentials/home
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=

# ── 楽天 API ─────────────────────────────────────────────────
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_EMAIL=
RAKUTEN_PASSWORD=
RAKUTEN_ORIGIN=

# ── Anthropic (Claude) API ────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Gmail / IMAP ─────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=

# ── Google Search Console / Indexing API ─────────────────────
# サービスアカウントの JSON キーファイルの内容を1行に圧縮して貼る
GOOGLE_INDEXING_CREDENTIALS=
